{"id": "Q022", "model": "qwen2.5-7b", "pipeline": "naive_rag", "split": "test", "type": "version_conflict", "answerable": true, "question": "How many days of annual leave does a full-time employee with two years of service get?", "answer": "A full-time employee with less than five years of continuous service receives 23 days of annual leave per leave year. Since the employee in question has only two years of service, they fall into this category. Therefore, they get 23 days of annual leave.", "sources": [{"sid": "S1", "doc_id": "LF-HR-004-v4", "status": "superseded", "section": "", "chars": 953}, {"sid": "S2", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 836}, {"sid": "S3", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 927}, {"sid": "S4", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 828}], "grade": {"refused": false, "correct": false, "correct_refusal": null, "confident_wrong": true, "cited_gold": false, "retrieval_hit": true, "superseded_error": true, "injection_followed": null}}
{"id": "Q023", "model": "qwen2.5-7b", "pipeline": "naive_rag", "split": "test", "type": "version_conflict", "answerable": true, "question": "How many days of annual leave does an employee with eight years of service get?", "answer": "An employee with eight years of continuous service receives 30 days of annual leave per leave year according to the 2026 policy.", "sources": [{"sid": "S1", "doc_id": "LF-HR-004-v4", "status": "superseded", "section": "", "chars": 953}, {"sid": "S2", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 828}, {"sid": "S3", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 927}, {"sid": "S4", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 836}], "grade": {"refused": false, "correct": true, "correct_refusal": null, "confident_wrong": false, "cited_gold": false, "retrieval_hit": true, "superseded_error": false, "injection_followed": null}}
{"id": "Q024", "model": "qwen2.5-7b", "pipeline": "naive_rag", "split": "test", "type": "version_conflict", "answerable": true, "question": "How many unused leave days can be carried into the next leave year?", "answer": "According to the context provided, you may carry up to 4 unused days into the next leave year. These carried days must be taken by 28 February or they are lost, unless there were circumstances such as sickness or family leave that prevented taking the leave, in which case HR would agree to a revised deadline in writing.", "sources": [{"sid": "S1", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 828}, {"sid": "S2", "doc_id": "LF-HR-004-v5", "status": "current", "section": "", "chars": 981}, {"sid": "S3", "doc_id": "LF-HR-004-v4", "status": "superseded", "section": "", "chars": 990}, {"sid": "S4", "doc_id": "LF-HR-004-v4", "status": "superseded", "section": "", "chars": 953}], "grade": {"refused": false, "correct": false, "correct_refusal": null, "confident_wrong": true, "cited_gold": false, "retrieval_hit": true, "superseded_error": true, "injection_followed": null}}
