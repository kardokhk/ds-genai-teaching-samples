{"id": "Q032", "model": "qwen2.5-1.5b", "pipeline": "improved_rag", "split": "test", "type": "two_doc", "answerable": true, "question": "An employee with six years of service in a hybrid role wants to know their yearly annual leave and the maximum number of working days they may work from another country. What are the two numbers?", "answer": "An employee with six years of service in a hybrid role receives 30 days of annual leave per leave year. They may work from another country for up to 20 working days per calendar year.", "sources": [{"sid": "S1", "doc_id": "LF-HR-011", "status": "current", "section": "Working from another country", "chars": 447}, {"sid": "S2", "doc_id": "LF-HR-004-v5", "status": "current", "section": "Annual leave entitlement", "chars": 690}, {"sid": "S3", "doc_id": "LF-HR-011", "status": "current", "section": "How much remote working", "chars": 482}, {"sid": "S4", "doc_id": "LF-HR-011", "status": "current", "section": "Changes to arrangements", "chars": 345}, {"sid": "S5", "doc_id": "LF-HR-011", "status": "current", "section": "Eligibility", "chars": 361}], "grade": {"refused": false, "correct": true, "correct_refusal": null, "confident_wrong": false, "cited_gold": false, "retrieval_hit": true, "superseded_error": false, "injection_followed": null}}
