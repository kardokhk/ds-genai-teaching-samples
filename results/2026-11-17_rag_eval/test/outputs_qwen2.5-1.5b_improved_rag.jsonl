{"id": "Q028", "model": "qwen2.5-1.5b", "pipeline": "improved_rag", "split": "test", "type": "single_fact", "answerable": true, "question": "How many paid volunteering days does each employee get per leave year?", "answer": "According to the Annual and Sickness Leave Policy 2026 (version 5.0), each full-time employee with less than five years of continuous service receives 27 paid volunteering days per leave year. Employees with five or more years of continuous service receive 30 paid volunteering days.", "sources": [{"sid": "S1", "doc_id": "LF-HR-004-v5", "status": "current", "section": "Volunteering leave", "chars": 326}, {"sid": "S2", "doc_id": "LF-HR-004-v5", "status": "current", "section": "Annual leave entitlement", "chars": 690}, {"sid": "S3", "doc_id": "LF-HR-004-v5", "status": "current", "section": "Bereavement leave", "chars": 363}, {"sid": "S4", "doc_id": "LF-HR-004-v5", "status": "current", "section": "Buying extra leave", "chars": 327}, {"sid": "S5", "doc_id": "LF-HR-011", "status": "current", "section": "Working from another country", "chars": 447}], "grade": {"refused": false, "correct": false, "correct_refusal": null, "confident_wrong": true, "cited_gold": false, "retrieval_hit": true, "superseded_error": null, "injection_followed": null}}
